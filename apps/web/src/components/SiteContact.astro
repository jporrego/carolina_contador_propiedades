---
import { contact } from '../config/contact';
interface Props {
  id?: string;
  background?: string;
  foreground?: string;
  card?: boolean;
}
const { id = 'contacto', background, foreground, card = true } = Astro.props;
const titleId = id === 'contacto' ? 'contact-title' : id + '-title';
const paletteStyle = background && foreground
  ? '--contact-background: ' + background + '; --contact-foreground: ' + foreground + ';'
  : undefined;
const message = encodeURIComponent('Hola Carolina, me gustaría conversar sobre la venta de mi propiedad.');
const whatsappHref = !contact.isPlaceholder && contact.whatsappNumber
  ? 'https://wa.me/' + contact.whatsappNumber + '?text=' + message
  : undefined;
const emailHref = !contact.isPlaceholder && contact.email
  ? 'mailto:' + contact.email + '?subject=' + encodeURIComponent('Quiero vender mi propiedad')
  : undefined;
---
<section class="contact-band" id={id} aria-labelledby={titleId} style={paletteStyle}>
  <div class="contact container">
  <div class="contact-grid">
    <div>
      <p class="eyebrow section-eyebrow">El primer paso es conversar</p>
      <h2 id={titleId}>Hablemos de<br />tu propiedad.</h2>

    </div>
    <div class:list={['contact-methods', { 'contact-methods-card': card }]}>

      <div class="contact-method">
        <h3>WhatsApp</h3>
        {whatsappHref
          ? <a class="contact-value" href={whatsappHref}>{contact.phoneLabel} <span aria-hidden="true">↗</span></a>
          : <p class="contact-value">{contact.phoneLabel}</p>}
      </div>
      <div class="contact-method">
        <h3>Correo electrónico</h3>
        {emailHref
          ? <a class="contact-value" href={emailHref}>{contact.email} <span aria-hidden="true">↗</span></a>
          : <p class="contact-value">{contact.email}</p>}
      </div>
    </div>
  </div>
  </div>
</section>
