---
import { contact } from '../config/contact';
const message = encodeURIComponent('Hola Carolina, me gustaría conversar sobre la venta de mi propiedad.');
const whatsappHref = !contact.isPlaceholder && contact.whatsappNumber
  ? 'https://wa.me/' + contact.whatsappNumber + '?text=' + message
  : undefined;
const emailHref = !contact.isPlaceholder && contact.email
  ? 'mailto:' + contact.email + '?subject=' + encodeURIComponent('Quiero vender mi propiedad')
  : undefined;
---
<section class="contact-band" id="contacto" aria-labelledby="contact-title">
  <div class="contact container">
  <div class="contact-grid">
    <div>
      <svg class="contact-symbol" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M8 30 32 10l24 20 M15 26v28h34V26 M26 54V37h12v17" />
      </svg>
      <h2 id="contact-title">Hablemos de<br />tu propiedad.</h2>
      <p class="section-description">Cuéntame qué tienes en mente.</p>
    </div>
    <div class="contact-methods">
      <div class="contact-method">
        <h3>WhatsApp</h3>
        {whatsappHref
          ? <a class="contact-value" href={whatsappHref}>{contact.phoneLabel} <span aria-hidden="true">↗</span></a>
          : <p class="contact-value">{contact.phoneLabel}</p>}
      </div>
      <div class="contact-method">
        <h3>Correo electrónico</h3>
        {emailHref
          ? <a class="contact-value" href={emailHref}>{contact.email} <span aria-hidden="true">↗</span></a>
          : <p class="contact-value">{contact.email}</p>}
      </div>
    </div>
  </div>
  </div>
</section>
