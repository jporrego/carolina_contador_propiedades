---
import PropertyImage from './PropertyImage.astro';
import type { PropertyPhoto } from '../data/properties';
interface Props { photos: PropertyPhoto[]; }
const { photos } = Astro.props;
function fullImage(photo: PropertyPhoto) {
  const url = new URL(photo.url);
  ['h', 'crop', 'fp-x', 'fp-y'].forEach((key) => url.searchParams.delete(key));
  url.searchParams.set('w', '2400');
  url.searchParams.set('fit', 'max');
  return url.toString();
}
---
<property-carousel aria-label="Fotografías de la propiedad">
  <div class="carousel-track" tabindex="0" aria-label="Galería: usa las flechas para cambiar de foto">
    {photos.map((photo, index) => (
      <a class="carousel-slide" href={fullImage(photo)} data-index={index}
        aria-label={'Ampliar fotografía ' + (index + 1) + ': ' + photo.alt}>
        <PropertyImage photo={photo} eager={index === 0} sizes="90vw" />
        <span class="expand-photo" aria-hidden="true">Ampliar ↗</span>
      </a>
    ))}
  </div>
  {photos.length > 1 && <div class="carousel-controls">
    <button type="button" data-prev aria-label="Fotografía anterior">←</button>
    <p class="carousel-count" aria-live="polite" aria-atomic="true">1 / {photos.length}</p>
    <button type="button" data-next aria-label="Fotografía siguiente">→</button>
  </div>}
  <dialog class="photo-dialog" aria-label="Fotografía ampliada">
    <div class="viewer-toolbar">
      <p data-viewer-count aria-live="polite" aria-atomic="true"></p>
      <button type="button" data-close autofocus aria-label="Cerrar fotografía ampliada">Cerrar ×</button>
    </div>
    <div class="viewer-stage">
      {photos.length > 1 && <button type="button" data-viewer-prev aria-label="Fotografía anterior">←</button>}
      <img data-viewer-image alt="" />
      {photos.length > 1 && <button type="button" data-viewer-next aria-label="Fotografía siguiente">→</button>}
    </div>
    <p data-viewer-caption></p>
  </dialog>
</property-carousel>

<script>
  class PropertyCarousel extends HTMLElement {
    connectedCallback() {
      const track = this.querySelector<HTMLElement>('.carousel-track')!;
      const slides = Array.from(this.querySelectorAll<HTMLAnchorElement>('.carousel-slide'));
      const dialog = this.querySelector<HTMLDialogElement>('dialog')!;
      const image = this.querySelector<HTMLImageElement>('[data-viewer-image]')!;
      const count = this.querySelector<HTMLElement>('.carousel-count');
      const caption = this.querySelector<HTMLElement>('[data-viewer-caption]')!;
      const viewerCount = this.querySelector<HTMLElement>('[data-viewer-count]')!;
      let index = 0;
      let opener: HTMLElement | null = null;
      let previousOverflow = '';
      const wrap = (value: number) => (value + slides.length) % slides.length;
      const updateViewer = () => {
        image.src = slides[index].href;
        image.alt = slides[index].querySelector('img')?.alt || '';
        caption.textContent = image.alt;
        viewerCount.textContent = (index + 1) + ' / ' + slides.length;
      };
      const move = (change: number) => {
        index = wrap(index + change);
        track.scrollTo({ left: index * track.clientWidth, behavior: 'instant' });
        if (count) count.textContent = (index + 1) + ' / ' + slides.length;
        if (dialog.open) updateViewer();
      };
      track.addEventListener('scroll', () => {
        if (dialog.open) return;
        index = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / track.clientWidth)));
        if (count) count.textContent = (index + 1) + ' / ' + slides.length;
      }, { passive: true });
      slides.forEach((slide, position) => slide.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        index = position;
        opener = slide;
        updateViewer();
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        dialog.showModal();
      }));
      this.querySelector('[data-prev]')?.addEventListener('click', () => move(-1));
      this.querySelector('[data-next]')?.addEventListener('click', () => move(1));
      this.querySelector('[data-viewer-prev]')?.addEventListener('click', () => move(-1));
      this.querySelector('[data-viewer-next]')?.addEventListener('click', () => move(1));
      this.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('close', () => {
        document.body.style.overflow = previousOverflow;
        opener?.focus({ preventScroll: true });
      });
      this.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          move(event.key === 'ArrowLeft' ? -1 : 1);
        }
      });
    }
  }
  if (!customElements.get('property-carousel')) customElements.define('property-carousel', PropertyCarousel);
</script>

<style>
  property-carousel { display: block; margin-block: 2rem; }
  .carousel-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: var(--radius); }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-slide { position: relative; flex: 0 0 100%; min-width: 0; scroll-snap-align: start; scroll-snap-stop: always; cursor: zoom-in; }
  .carousel-slide :global(img) { width: 100%; height: clamp(18rem, 48vw, 38rem); object-fit: cover; }
  .expand-photo { position: absolute; bottom: 1rem; right: 1rem; background: var(--color-background); padding: .5rem .85rem; border-radius: 2rem; font-size: var(--text-small); font-weight: 600; }
  .carousel-controls { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-top: .6rem; }
  button { cursor: pointer; border: 1px solid var(--color-border); background: var(--color-background); color: var(--color-text); border-radius: 2rem; min-width: 44px; min-height: 44px; padding: .5rem .9rem; }
  button:hover { background: #eae4db; }
  .carousel-count { margin: 0; font-size: .85rem; font-variant-numeric: tabular-nums; }
  .photo-dialog { width: min(96vw, 100rem); max-width: 96vw; max-height: 96dvh; border: 0; border-radius: .75rem; padding: 1rem; background: #1e1c19; color: #f6f3ee; }
  .photo-dialog::backdrop { background: rgb(0 0 0 / .85); }
  .viewer-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .viewer-toolbar p { margin: 0; }
  .viewer-stage { display: flex; align-items: center; justify-content: center; gap: .75rem; margin-top: 1rem; }
  .viewer-stage img { min-width: 0; max-width: 100%; max-height: 72dvh; object-fit: contain; flex: 1; }
  .viewer-stage button { flex-shrink: 0; }
  [data-viewer-caption] { text-align: center; font-size: var(--text-small); margin-bottom: 0; }
  @media (max-width: 600px) {
    .photo-dialog { padding: .75rem; }
    .viewer-stage { position: relative; padding-bottom: 3.5rem; }
    .viewer-stage button { position: absolute; bottom: 0; }
    [data-viewer-prev] { left: 25%; }
    [data-viewer-next] { right: 25%; }
    .viewer-stage img { max-height: 62dvh; }
  }
</style>
