---
import PropertyCard from './PropertyCard.astro';
import { properties } from '../data/properties';
---
<section class="featured container" aria-labelledby="featured-title">
  <div class="featured-heading">
    <div><p class="eyebrow">Propiedades</p><h2 id="featured-title">Espacios para<br /><span>una nueva historia.</span></h2></div>
    <a class="text-link" href="/propiedades/">Explorar propiedades <span aria-hidden="true">↗</span></a>
  </div>
  
  <div class="property-grid">{properties.slice(0, 2).map((property) => <PropertyCard property={property} />)}</div>
</section>
