---
import PropertyImage from './PropertyImage.astro';
import { formatPrice, availability, type Property } from '../data/properties';
interface Props { property: Property; }
const { property } = Astro.props;
---
<article class="property-card">
  <a href={'/propiedades/' + property.slug + '/'} class="property-card-link">
    <div class="property-card-image">
      <PropertyImage photo={property.photos[0]} />
      <span class="property-badge">{property.type} · {availability(property)}</span>
    </div>
    <div class="property-card-heading"><h3>{property.title}</h3><span aria-hidden="true">↗</span></div>
    <p class="property-location">{property.location}</p>
    <p class="property-specs">
      {property.type !== 'Terreno' && <>{property.bedrooms} dorm. · {property.bathrooms} baños</>}
      {property.areaM2 && <> · {property.areaM2} m² interiores</>}
      {property.landAreaM2 && <> · {property.landAreaM2} m² de terreno</>}
    </p>
    <p class="property-price">{formatPrice(property)}</p>
  </a>
</article>
