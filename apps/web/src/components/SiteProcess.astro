---
const steps = [
  { title: 'Conversemos', text: 'Tu propiedad, tus tiempos y tus objetivos.' },
  { title: 'Preparemos', text: 'Definimos el precio y la presentación.' },
  { title: 'Publiquemos', text: 'Gestionamos las consultas y las visitas.' },
  { title: 'Avancemos', text: 'Revisamos propuestas y coordinamos el cierre.' },
];
---
<section class="process-band" id="proceso" aria-labelledby="process-title">
  <div class="process container">
    <h2 class="section-label" id="process-title">Cómo trabajamos</h2>
    <ol class="process-list">
      {steps.map((step, index) => <li>
        <span class="step-number" aria-hidden="true">0{index + 1}</span>
        <h3>{step.title}</h3><p>{step.text}</p>
      </li>)}
    </ol>
  </div>
</section>
