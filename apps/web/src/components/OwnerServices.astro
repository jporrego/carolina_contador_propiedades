---
const services = [
  { number: '01', title: 'Una presentación que destaque', text: 'Cuidamos las fotografías, la descripción y los detalles para mostrar lo que hace especial a tu propiedad.' },
  { number: '02', title: 'Difusión con un propósito', text: 'Definimos cómo presentar tu propiedad y acercarla a personas que estén buscando un lugar como el tuyo.' },
  { number: '03', title: 'Acompañamiento en cada etapa', text: 'Coordinamos las visitas, conversamos sobre las consultas recibidas y revisamos juntos los siguientes pasos.' },
];
---
<section class="services container" id="propietarios" aria-labelledby="services-title">
  <div class="section-heading">
    <p class="eyebrow">02 / Para propietarios</p>
    <div>
      <h2 id="services-title">Tu propiedad merece<br /><span>una atención especial.</span></h2>
      <p class="section-description">Desde la primera conversación hasta la decisión de venta, una gestión cercana y una presentación cuidada.</p>
    </div>
  </div>
  <div class="service-grid">
    {services.map((service) => (
      <article class="service-item">
        <span class="service-number" aria-hidden="true">{service.number}</span>
        <h3>{service.title}</h3>
        <p>{service.text}</p>
      </article>
    ))}
  </div>
</section>
