---
const services = [
  { title: 'Presentación', text: 'Fotografías y descripciones que muestran lo mejor de tu propiedad.' },
  { title: 'Difusión', text: 'Publicación, atención de consultas y coordinación de visitas.' },
  { title: 'Acompañamiento', text: 'Seguimiento de propuestas y apoyo hasta el cierre de la venta.' },
];
---
<section class="services container" id="propietarios" aria-labelledby="services-title">
  <h2 class="section-label" id="services-title">Servicios para propietarios</h2>
  <div class="service-grid">
    {services.map((service) => <article class="service-item">
      <h3>{service.title}</h3><p>{service.text}</p>
    </article>)}
  </div>
</section>
