---
import { Image } from 'astro:assets';

import serviceInterior from '../assets/living-comedor-ventanales-jardin.webp';
const services = [
  { title: 'Presento tu propiedad', text: 'Cuido las fotografías y la descripción para mostrar sus espacios, sus atributos y la información que un comprador necesita.', icon: 'M4 7h4l2-3h4l2 3h4v13H4Z M16 13a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z' },
  { title: 'Gestiono consultas y visitas', text: 'Me encargo de la difusión, respondo las consultas y coordino las visitas contigo. Tú no tienes que estar pendiente de cada mensaje.', icon: 'M3 10h5l12-6v16L8 14H3Z M6 14l2 7h4l-2-6' },
  { title: 'Doy seguimiento a las propuestas', text: 'Te mantengo al tanto del interés y las ofertas, y te acompaño en los siguientes pasos. Tú decides con la información sobre la mesa.', icon: 'M4 4h16v13H10l-6 4Z M8 10l3 3 5-6' },
];
---
<section class="services-band" id="propietarios" aria-labelledby="services-title">
  <div class="services container">
    <div class="service-intro">
      <p class="eyebrow section-eyebrow">Servicios para propietarios</p>
      <h2 id="services-title">Tu propiedad merece<br />una buena gestión.</h2>
      <p class="section-description">Desde la publicación hasta las propuestas, me encargo de los detalles y te mantengo al tanto.</p>
      <figure class="service-image">
        <Image src={serviceInterior} alt="Living y comedor de tonos claros, con grandes ventanales abiertos al jardín."
          widths={[480, 800, 1200]} sizes="(max-width: 900px) 90vw, 42vw"
          width={1200} format="webp" loading="lazy" />
      </figure>
    </div>
    <div class="service-list">
      {services.map((service) => <article class="service-item">
        <span class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d={service.icon} /></svg></span>
        <div><h3>{service.title}</h3><p class="service-description">{service.text}</p></div>
      </article>)}
    </div>
  </div>
  <div class="services-cta container" id="consulta">
    <p>¿Estás pensando en vender?</p>

      <a class="button button-strong-label" href="#contacto"><span class="button-label">Conversemos sobre tu propiedad</span><span class="button-arrow" aria-hidden="true">↗</span></a>
  </div>
</section>
