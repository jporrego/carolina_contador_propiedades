---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import OwnerServices from '../components/OwnerServices.astro';
import SiteProcess from '../components/SiteProcess.astro';
import SiteContact from '../components/SiteContact.astro';
import FeaturedProperties from '../components/FeaturedProperties.astro';
import interior from '../assets/interior.jpg';
import { getHomepage } from '../data/homepage';
const content = await getHomepage();
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <Image class="hero-image" src={interior}
      alt="Living luminoso con materiales naturales y amplios ventanales."
      widths={[640, 960, 1440, 2000]} sizes="100vw" width={2000}
      loading="eager" fetchpriority="high" format="webp" />
    <div class="hero-content">
      <h1 id="hero-title">{content.heroLine1}<br />{content.heroLine2}</h1>
      <div class="hero-bottom">
        <p>{content.heroDescription}</p>
        <div class="hero-links">
          <a class="button button-light" href="#contacto">Vender mi propiedad <span class="button-arrow" aria-hidden="true">↗</span></a>
          <a class="hero-secondary" href="/propiedades/">Ver propiedades <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="about container" id="carolina" aria-labelledby="about-title">
    <p class="section-label">Carolina Contador Cortes</p>
    <div class="about-content">
      <h2 id="about-title">{content.aboutTitle}</h2>
      <div class="about-copy">
        <p>{content.aboutParagraph1}</p>
        {content.aboutParagraph2 && <p>{content.aboutParagraph2}</p>}
      </div>
    </div>
  </section>
  <OwnerServices />
  <SiteProcess />
  <FeaturedProperties />
  <SiteContact />
</BaseLayout>
