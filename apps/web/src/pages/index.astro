---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import OwnerServices from '../components/OwnerServices.astro';
import SiteContact from '../components/SiteContact.astro';
import FeaturedProperties from '../components/FeaturedProperties.astro';
import { getHomepage } from '../data/homepage';
const content = await getHomepage();
---
<BaseLayout>
  <LandingHero content={content} />

  <section class="about container" id="carolina" aria-labelledby="about-title">
    <div class="about-identity">
      <span class="about-monogram" aria-hidden="true">cc.</span>
      <p class="about-name">Carolina <br />Contador Cortes</p>
      <p class="section-label">Asesoría inmobiliaria</p>
      <a class="text-link" href="#contacto">Conversemos <span aria-hidden="true">↗</span></a>
    </div>
    <div class="about-content">
      <p class="eyebrow section-eyebrow">Una gestión cercana y personal</p>
      <h2 id="about-title">{content.aboutTitle}</h2>
      <div class="about-copy">
        <p>{content.aboutParagraph1}</p>
        {content.aboutParagraph2 && <p>{content.aboutParagraph2}</p>}
      </div>
      <div class="about-principles">
        <div><h3>Trato directo</h3><p>Una persona a tu lado durante todo el proceso.</p></div>
        <div><h3>Criterio y dedicación</h3><p>Cada propiedad merece una mirada propia.</p></div>
      </div>
    </div>
  </section>
  <OwnerServices />
  <FeaturedProperties />
  <SiteContact />
</BaseLayout>
