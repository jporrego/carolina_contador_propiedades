---
import PropertyCarousel from '../../components/PropertyCarousel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { getProperties, formatPrice, availability, photoUrl } from '../../data/properties';

export async function getStaticPaths() {
  const properties = await getProperties();
  return properties.map((property) => ({ params: { slug: property.slug }, props: { property } }));
}
const { property } = Astro.props;
const related = (await getProperties()).filter((item) => item.slug !== property.slug);
const propertyContext = property.type + (property.operation === 'rent' ? ' en arriendo en ' : ' en venta en ') + property.location;
const seoTitle = property.title + ' — ' + propertyContext + ' | Carolina Contador';
const seoDescription = [propertyContext, formatPrice(property), property.areaM2 ? property.areaM2 + ' m² interiores' : '', property.landAreaM2 ? property.landAreaM2 + ' m² de terreno' : '', 'Revisa fotografías, características y coordina una visita con Carolina.'].filter(Boolean).join('. ');
const breadcrumb = { '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
  { '@type': 'ListItem', position: 2, name: 'Propiedades', item: new URL('/propiedades/', Astro.site).href },
  { '@type': 'ListItem', position: 3, name: property.title, item: new URL(Astro.url.pathname, Astro.site).href },
] };
---
<BaseLayout title={seoTitle} description={seoDescription} image={photoUrl(property.photos[0], 1200, 1200 / 630)} imageAlt={property.photos[0].alt} pageType="RealEstateListing" structuredData={[breadcrumb]}>
  <article class="property-detail container">
    <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/propiedades/">Propiedades</a><span aria-hidden="true">/</span><span aria-current="page">{property.title}</span></nav>
    
    <p class="eyebrow">{property.type} / {availability(property)}</p>
    <h1>{property.title}</h1>
    <p class="property-location">{property.location}</p>
    <PropertyCarousel photos={property.photos} />
    <div class="detail-grid">
      <div>
        <dl class="property-facts">
          {property.type !== 'Terreno' && <div><dt>Dormitorios</dt><dd>{property.bedrooms}</dd></div>}
          {property.type !== 'Terreno' && <div><dt>Baños</dt><dd>{property.bathrooms}</dd></div>}
          {property.areaM2 && <div><dt>Superficie interior</dt><dd>{property.areaM2} m²</dd></div>}{property.landAreaM2 && <div><dt>Terreno</dt><dd>{property.landAreaM2} m²</dd></div>}
        </dl>
        <section aria-labelledby="description-title"><h2 id="description-title">Sobre este espacio</h2><p class="detail-description">{property.description}</p></section>
        {property.features.length > 0 && <section class="property-features" aria-labelledby="features-title"><h2 id="features-title">Características</h2><ul>{property.features.map((feature) => <li>{feature}</li>)}</ul></section>}
      </div>
      <aside class="property-inquiry" aria-label="Precio y contacto">
        <p class="eyebrow">Precio</p><p class="detail-price">{formatPrice(property)}</p>
        <p>Consulta por esta propiedad o coordina una visita.</p>
        <a class="button" href="/#contacto">Conversar con Carolina <span class="button-arrow" aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </article>
  {related.length > 0 && <section class="related container" aria-labelledby="related-title"><h2 id="related-title">Otros espacios</h2><div class="property-grid">{related.map((item) => <PropertyCard property={item} />)}</div><a class="text-link" href="/propiedades/">Ver todas las propiedades <span aria-hidden="true">↗</span></a></section>}
</BaseLayout>
