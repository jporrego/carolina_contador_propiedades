---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { properties, formatPrice } from '../../data/properties';

export function getStaticPaths() {
  return properties.map((property) => ({ params: { slug: property.slug }, props: { property } }));
}
const { property } = Astro.props;
const related = properties.filter((item) => item.slug !== property.slug);
---
<BaseLayout title={property.title + ' | Carolina Contador Cortes'} description={property.description} noindex>
  <article class="property-detail container">
    <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/propiedades/">Propiedades</a><span aria-hidden="true">/</span><span aria-current="page">Detalle</span></nav>
    
    <p class="eyebrow">{property.type} / En venta</p>
    <h1>{property.title}</h1>
    <p class="property-location">{property.location}</p>
    <figure class="detail-photo">
      <Image src={property.image} alt={property.imageAlt} widths={[640, 960, 1440, 1600]} sizes="90vw" width={1600} format="webp" loading="eager" fetchpriority="high" />
      
    </figure>
    <div class="detail-grid">
      <div>
        <dl class="property-facts">
          <div><dt>Dormitorios</dt><dd>{property.bedrooms}</dd></div>
          <div><dt>Baños</dt><dd>{property.bathrooms}</dd></div>
          <div><dt>Superficie interior</dt><dd>{property.areaM2} m²</dd></div>
        </dl>
        <section aria-labelledby="description-title"><h2 id="description-title">Sobre este espacio</h2><p class="detail-description">{property.description}</p></section>
        <section class="property-features" aria-labelledby="features-title"><h2 id="features-title">Características</h2><ul>{property.features.map((feature) => <li>{feature}</li>)}</ul></section>
      </div>
      <aside class="property-inquiry" aria-label="Precio y contacto">
        <p class="eyebrow">Precio</p><p class="detail-price">{formatPrice(property.priceUf)}</p>
        <p>¿Te interesa esta propiedad? Conversemos sobre sus detalles y coordinemos el siguiente paso.</p>
        <a class="button" href="/#contacto">Conversar con Carolina <span class="button-arrow" aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </article>
  <section class="related container" aria-labelledby="related-title"><h2 id="related-title">Otros espacios</h2><div class="property-grid">{related.map((item) => <PropertyCard property={item} />)}</div><a class="text-link" href="/propiedades/">Ver todas las propiedades <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
